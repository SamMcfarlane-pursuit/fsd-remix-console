rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny-all policy
    match /{document=**} {
      allow read, write: if false;
    }

    // Authenticated access for emergency life-safety muster management
    match /occupants/{occupantId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role in ['commander', 'warden', 'admin'];
    }
    match /ledger_entries/{entryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role in ['commander', 'admin'];
    }
    match /system_state/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role in ['commander', 'admin'];
    }
    match /broadcast_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role in ['commander', 'warden', 'admin'];
    }
    match /chat_messages/{msgId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}

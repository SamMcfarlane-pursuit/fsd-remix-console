# ==============================================================================
# Con Edison MusterCommand Production Environment Variables
# ==============================================================================

# Server & Runtime
PORT=3000
NODE_ENV=production

# Gemini AI (Drill Narratives & Red-List Query Engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Production Database (PostgreSQL / Google Cloud SQL / Supabase / AWS RDS)
DATABASE_URL=postgres://coned_admin:LifeSafety2026!@localhost:5432/mustercommand_db
# POSTGRES_URL=postgres://user:password@host:5432/database

# Optional: Firebase Real-Time Synchronization
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Optional: Twilio SMS / Voice Broadcast Gateway
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+12125550199
